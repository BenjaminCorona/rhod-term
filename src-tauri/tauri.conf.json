{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rhod",
  "version": "0.10.2",
  "identifier": "com.benja.rhod",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Rhod",
        "width": 900,
        "height": 600,
        "minWidth": 480,
        "minHeight": 320,
        "devtools": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJGQTdGRDY4QjM3QUU5QjEKUldTeDZYcXphUDJudjBxUXRZY3dIcThpUkZhWHFpVEpENS9sODVLWndwOHk4enpsLzQxbThpODcK",
      "endpoints": [
        "https://github.com/BenjaminCorona/rhod-term/releases/latest/download/latest.json"
      ]
    }
  }
}
